{
  "name": "dental-lab-system",
  "private": true,
  "description": "Dental lab management system (product name TBD) — built by Smile Artec Dental Laboratory",
  "workspaces": [
    "packages/shared",
    "apps/api"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "npm run build -w packages/shared",
    "dev": "npm run dev -w apps/api",
    "build": "npm run build -w packages/shared && npm run build -w apps/api",
    "lint": "npm run lint -w apps/api",
    "typecheck": "npm run typecheck -w apps/api",
    "test": "npm run test -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "test:e2e": "npm run test:e2e -w apps/api",
    "i18n:check": "npm run i18n:check -w apps/api",
    "migrate": "npm run migrate -w apps/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  }
}
