{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\"",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning scripts/jest.cjs --selectProjects unit",
    "test:integration": "node --experimental-vm-modules --disable-warning=ExperimentalWarning scripts/jest.cjs --selectProjects integration --runInBand",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning scripts/jest.cjs --selectProjects e2e --runInBand",
    "i18n:check": "node -r ts-node/register scripts/check-i18n.ts",
    "openapi:export": "node -r ts-node/register scripts/export-openapi.ts",
    "migrate": "node --env-file-if-exists=../../.env -r ts-node/register scripts/migrate.ts",
    "seed:demo": "node --env-file-if-exists=../../.env -r ts-node/register scripts/seed-demo.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@app/shared": "*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.4.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
