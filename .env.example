# Copy to `.env` (git-ignored) and fill in the empty values. Development only.
# Never commit real secrets. Generate random values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- Docker Compose (development database) ---
POSTGRES_USER=lab_dev
POSTGRES_PASSWORD=
POSTGRES_DB=lab_dev
POSTGRES_PORT=54329

# --- API ---
NODE_ENV=development
# Loopback only (127.0.0.1 or ::1): one computer per installation.
API_HOST=127.0.0.1
API_PORT=4310
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=
# Required, at least 32 random characters. Production refuses to start if missing or weak.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
# Set to false when migrations are run separately (the installer backs up first).
MIGRATE_ON_START=true
LOG_LEVEL=info
# Optional: folder of the built web UI (apps/web/dist) served by the API on the same origin.
# Leave unset in development (Vite serves the UI on :5173 and proxies /api).
# WEB_DIST_DIR=apps/web/dist
# Initial lab time zone used by first-run setup (IANA name). The installer sets it from Windows.
DEFAULT_TIME_ZONE=Asia/Hebron
